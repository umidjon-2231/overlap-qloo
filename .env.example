# Root .env is read by apps/api in dev and by docker compose in production (never committed)
QLOO_API_KEY=
QLOO_API_URL=https://hackathon.api.qloo.com
CLAUDE_API_KEY=

# Dev only (compose sets DATABASE_URL itself)
DATABASE_URL=postgresql://user:password@localhost:5432/overlap
API_PORT=8787
WEB_ORIGIN=http://localhost:3000

# Agent
AGENT_MODEL=claude-haiku-5-5
AGENT_EFFORT=high
AGENT_TOOLSET=business
PITCH_MODEL=claude-sonnet-5-5
RUN_TOOL_CALL_LIMIT=30
RUN_QLOO_CALL_LIMIT=120
RUN_TOKEN_BUDGET=600000
CACHE_TTL_HOURS=24
PRESET_CACHE_HOURS=24

# Public-demo guard (estimated model spend; past a budget, live runs and new pitches pause, examples still work)
DEMO_HOURLY_BUDGET_USD=3
DEMO_DAILY_BUDGET_USD=10
DEMO_MONTHLY_BUDGET_USD=30
DEMO_DAILY_QLOO_CALLS=1500
DEMO_RUNS_PER_IP_HOUR=8
DEMO_PITCHES_PER_IP_HOUR=10
DEMO_REQUESTS_PER_IP_DAY=30
# true only for local experiments: lets API clients pick the agent model
ALLOW_RUN_CONFIG=false
# Budget alerts (press Start in the bot's chat first, or Telegram answers "chat not found")
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Production (docker compose)
DOMAIN=overlap.u.co.uz
POSTGRES_PASSWORD=
