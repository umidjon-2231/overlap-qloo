{
  "name": "@overlap/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/server.ts",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file=../../.env src/db/migrate.ts",
    "probe": "tsx --env-file=../../.env src/scripts/coverage-probe.ts",
    "tool": "tsx --env-file=../../.env src/scripts/tool.ts",
    "agent": "tsx --env-file=../../.env src/scripts/run-agent.ts",
    "bakeoff": "tsx --env-file=../../.env src/scripts/bakeoff.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.134.0",
    "@hono/node-server": "^2.1.5",
    "@overlap/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "marked": "^18.1.1",
    "pdfkit": "^0.20.2",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/pdfkit": "^0.17.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
